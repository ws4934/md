{
  "extends": "../../packages/config/tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@md/shared": ["../../packages/shared/src/index.ts"],
      "@md/shared/*": ["../../packages/shared/src/*"]
    },
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "release"]
}
